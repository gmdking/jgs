config_version=5

[application]

config/name="JGS"
config/version="b1.1.0"
run/main_scene="uid://c15qrd2w5kk6l"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/use_filter=false
boot_splash/image="uid://dpwfe53b0uu6a"
config/icon="uid://dpwfe53b0uu6a"

[autoload]

