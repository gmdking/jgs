[sub_resource type="GDScript" id="GDScript_4xowi"]
script/source = "extends CharacterBody3D

@export var speed := 5.0
@export var sprint_speed := 10.0
var lowjump := 4.5
var highjump := 9
var curjump := 9
@export var gravity := 9.8
@export var mouse_sensitivity := 0.002
var current_speed := 5.0
var walk_speed := 5.0
@export var pickup_key := \"pickup\"
@export var drop_key := \"drop\"
@export var pickup_range := 4.0
@export var hold_distance := 3.0

@onready var pivot = $CameraPivot
@onready var camera: Camera3D = $CameraPivot/Camera3D

var pitch := 0.0
var held_object: RigidBody3D = null

func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _input(event):
	if event is InputEventMouseMotion:
		# Left right look
		rotate_y(-event.relative.x * mouse_sensitivity)

		# Up down look
		pitch -= event.relative.y * mouse_sensitivity
		pitch = clamp(pitch, -PI/2, PI/2)
		pivot.rotation.x = pitch
	
	if event.is_action_pressed(\"pause\"): # Pause menu
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE) # Frees mouse on pause
		get_tree().change_scene_to_file(\"res://gui/menu.tscn\") # Changes scene to menu

func _physics_process(delta):
	# movement + gravity
	if not is_on_floor():
		velocity.y -= gravity * delta

	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = curjump
		
			# Sprint check
	if Input.is_action_pressed(\"sprint\") and Input.is_action_pressed(\"sprint2\"):

		current_speed = sprint_speed * 2
		curjump = highjump * 2

	elif Input.is_action_pressed(\"sprint\"):

		current_speed = sprint_speed
		curjump = highjump

	else:

		current_speed = walk_speed
		curjump = lowjump
		
	var input_dir = Input.get_vector(\"left\", \"right\", \"forward\", \"backward\")
	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	velocity.x = direction.x * current_speed
	velocity.z = direction.z * current_speed

	move_and_slide()

	# pickup handling
	if held_object:
		# move held object in front of camera
		var target_pos = camera.global_transform.origin + camera.global_transform.basis.z * -hold_distance
		held_object.freeze = true
		held_object.global_transform.origin = target_pos

		if Input.is_action_just_pressed(drop_key):
			drop_object()
	else:
		if Input.is_action_just_pressed(pickup_key):
			try_pickup()

func try_pickup():
	if camera == null:
		return

	var mouse_pos = get_viewport().get_mouse_position()
	var from = camera.project_ray_origin(mouse_pos)
	var to = from + camera.project_ray_normal(mouse_pos) * pickup_range

	var query = PhysicsRayQueryParameters3D.new()
	query.from = from
	query.to = to
	query.exclude = [self]

	var result = get_world_3d().direct_space_state.intersect_ray(query)
	if result and result.has(\"collider\") and result[\"collider\"] is RigidBody3D:
		held_object = result[\"collider\"]
		held_object.freeze = true

func drop_object():
	if held_object:
		held_object.freeze = false
		
		if pitch >0.01:
			held_object.linear_velocity = camera.global_transform.basis.z * -pitch * 12 # this feels SOOO nice dude
			
		held_object = null
"

